# Copy this file to .env and fill in your key.
# The ONLY required setting is GEMINI_API_KEY - everything else has defaults.

# Google AI Studio key: https://aistudio.google.com/apikey  (free tier is fine)
GEMINI_API_KEY=

# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: PostgreSQL / Supabase instead of the default local SQLite file.
# Supabase example (from Project Settings -> Database -> Connection string):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres

# Optional: frontend origin for CORS (default: http://localhost:3000)
# FRONTEND_ORIGIN=http://localhost:3000
